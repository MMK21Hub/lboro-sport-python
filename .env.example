# Legend facility-hire API endpoints and OAuth client credentials.
# `uv run bootstrap_config.py` fills these in automatically. They are not
# embedded in the Android app; they come from the club configuration that the
# app downloads at runtime.
LBORO_API_BASE_URL=https://your-legend-instance.example.com/api
LBORO_OAUTH_TOKEN_URL=https://your-legend-instance.example.com/oauth/token
LBORO_CLIENT_ID=replace-me
LBORO_CLIENT_SECRET=replace-me

# Optional. Only needed for endpoints that require a signed-in member
# (cart/booking/cancellation, not availability search).
LBORO_USERNAME=
LBORO_PASSWORD=
